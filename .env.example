# Copy this file to .env and fill in your values. Never commit .env.

# --- Provider selection: gemini | ollama ---
FORGELINE_DEFAULT_PROVIDER=gemini
FORGELINE_FAILOVER=true

# --- Gemini (free key from https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
# Model IDs change often; `forgeline doctor` shows whether your key and models are available.
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
GEMINI_MODEL_CODE=gemini-3.6-flash

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_LIGHT=qwen2.5-coder:3b
OLLAMA_MODEL_CODE=qwen2.5-coder:7b
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_S=1200
